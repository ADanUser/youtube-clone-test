# Copy to .env for local development. Never commit real credentials.
YOUTUBE_ENVIRONMENT=development
YOUTUBE_DEBUG=false
YOUTUBE_LOG_LEVEL=INFO

# The Compose stage will provide the real PostgreSQL URL.
YOUTUBE_DATABASE_URL=postgresql+asyncpg://youtube:development-only@localhost:5432/youtube
YOUTUBE_DATABASE_PASSWORD_FILE=

# HTTP/session security. Production reads the HMAC key from a protected file.
YOUTUBE_PUBLIC_ORIGIN=http://localhost:8080
YOUTUBE_TRUST_PROXY_HEADERS=false
YOUTUBE_COOKIE_SECURE=false
YOUTUBE_SESSION_TTL_SECONDS=604800
YOUTUBE_PREAUTH_CSRF_TTL_SECONDS=3600
YOUTUBE_AUTH_SECRET_FILE=
YOUTUBE_LOGIN_RATE_LIMIT_ATTEMPTS=5
YOUTUBE_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
YOUTUBE_REGISTRATION_RATE_LIMIT_ATTEMPTS=3
YOUTUBE_REGISTRATION_RATE_LIMIT_WINDOW_SECONDS=3600

# Garage S3 API. Application credentials are read from protected files in Compose.
YOUTUBE_S3_ENDPOINT_URL=http://localhost:3900
YOUTUBE_S3_REGION=garage
YOUTUBE_S3_BUCKET=videos
YOUTUBE_S3_ACCESS_KEY_FILE=/run/youtube-s3/access-key-id
YOUTUBE_S3_SECRET_KEY_FILE=/run/youtube-s3/secret-access-key

# garage-init contract for the next infrastructure stage.
YOUTUBE_GARAGE_LAYOUT_ZONE=local
YOUTUBE_GARAGE_LAYOUT_CAPACITY_BYTES=10000000000
YOUTUBE_GARAGE_APP_KEY_NAME=youtube-app
YOUTUBE_GARAGE_INIT_TIMEOUT_SECONDS=180
YOUTUBE_GARAGE_INIT_POLL_SECONDS=5
